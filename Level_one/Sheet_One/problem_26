#include<iostream>
using namespace std;
int main()
{
    
    long long n, a, b;
    cin >> n >> a >> b;
    if (n <= a)
    {
        cout << 1;
    }
    else if (a <= b)
    {
        cout << -1;
    }
    else {
        long long res = ((n - a) + (a - b)-1)/ (a - b);     
        cout << res + 1;
    }
}

